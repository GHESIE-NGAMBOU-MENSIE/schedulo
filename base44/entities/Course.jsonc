{
  "name": "Course",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "course_type": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Single-element array with one of: lecture_course, lecture_exercises, seminar, project_course, lab_course, bachelor_thesis, master_thesis, other"
    },
    "course_structure": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Student-confirmed structural elements: lectures, exercises, lab_work, supervision_meetings, assignments, quizzes, testate, seminar_presentation, paper_essay, project_work, implementation, thesis_writing, literature_work, final_exam, oral_exam, revision_buffer"
    },
    "credit_points": {
      "type": "number"
    },
    "exam_date": {
      "type": "string",
      "format": "date"
    },
    "exam_type": {
      "type": "string",
      "enum": [
        "exact",
        "window",
        "submission",
        "none",
        "unknown"
      ],
      "default": "unknown"
    },
    "exam_window_start": {
      "type": "string",
      "format": "date"
    },
    "exam_window_end": {
      "type": "string",
      "format": "date"
    },
    "course_start_date": {
      "type": "string",
      "format": "date"
    },
    "course_end_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "difficult"
      ],
      "default": "medium"
    },
    "familiarity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "materials_text": {
      "type": "string"
    },
    "material_files": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "file_extractions": {
      "type": "object",
      "description": "Maps file_url to the fields extracted from that file, so deleting a file can revert only its extracted data"
    },
    "confirmed": {
      "type": "boolean",
      "default": false
    },
    "tasks_extracted": {
      "type": "boolean",
      "default": false
    },
    "time_adjustment_factor": {
      "type": "number",
      "default": 1.0
    },
    "num_chapters": {
      "type": "number",
      "description": "Number of chapters or weekly topics"
    },
    "num_exercises": {
      "type": "number",
      "description": "Number of exercise sheets"
    },
    "num_assignments": {
      "type": "number",
      "description": "Number of assignments / submissions"
    },
    "num_quizzes": {
      "type": "number",
      "description": "Number of quizzes or Testate"
    }
  },
  "required": [
    "name",
    "plan_id"
  ]
}